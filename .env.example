# ========================================
# Global Application Settings
# ========================================
APP_ENV=development
BUILD_TARGET=dev
GO_VERSION=1.25.1
BUILD_OS=linux
BUILD_ARCH=amd64

# ========================================
# Common Database Settings
# These defaults can be overridden per-service if needed
# ========================================
COMMON_DB_HOST=mysql
COMMON_DB_PORT=3306 # Internal port, actual external host port will vary
COMMON_DB_ROOT_PASSWORD=rootpassword

# ========================================
# Common Redis Settings
# These defaults can be overridden per-service if needed
# ========================================
COMMON_REDIS_HOST=redis
COMMON_REDIS_PORT=6379 # Internal port, actual external host port will vary
COMMON_REDIS_PASSWORD=

# ========================================
# Common Jaeger Settings
# These defaults can be overridden per-service if needed
# ========================================
COMMON_JAEGER_HOST=jaeger
COMMON_JAEGER_PORT_UI=16686 # Jaeger UI internal port
COMMON_JAEGER_PORT_OTLP=4317 # Jaeger OTLP internal port
COMMON_JAEGER_PORT_OTLP_HTTP=4322 # Jaeger OTLP HTTP internal port

# ========================================
# Service: Items (商品服务)
# HTTP: 8086, gRPC: 50056, MySQL: 3306, Redis: 6379
# ========================================
ITEMS_APP_NAME=items-service
ITEMS_SERVER_PORT=8086
ITEMS_GRPC_PORT=50056
ITEMS_DB_USERNAME=fly_user
ITEMS_DB_PASSWORD=rootpassword
ITEMS_DB_NAME=items_dev
ITEMS_REDIS_ADDRESS=redis:6379 # Internal Redis address
ITEMS_REDIS_PASSWORD=${COMMON_REDIS_PASSWORD} # Use common Redis password


# ========================================
# Service: Appointments (预约服务)
# HTTP: 8083, gRPC: 9083, MySQL: 3306, Redis: 6379
# ========================================
APPOINTMENTS_APP_NAME=appointments-service
APPOINTMENTS_SERVER_HTTP_PORT=8083
APPOINTMENTS_SERVER_GRPC_PORT=9083
APPOINTMENTS_DB_HOST=${COMMON_DB_HOST}
APPOINTMENTS_DB_PORT=${COMMON_DB_PORT}
APPOINTMENTS_DB_USERNAME=appointments
APPOINTMENTS_DB_PASSWORD=password
APPOINTMENTS_DB_NAME=appointments
APPOINTMENTS_REDIS_HOST=${COMMON_REDIS_HOST}
APPOINTMENTS_REDIS_PORT=${COMMON_REDIS_PORT}
APPOINTMENTS_REDIS_PASSWORD=${COMMON_REDIS_PASSWORD}


# ========================================
# Service: Clotho (订单服务)
# HTTP: 8087, MySQL: 3306, Redis: 6379 (Internal)
# Depends on Custos, Plutus
# ========================================
CLOTHO_APP_NAME=clotho-service
CLOTHO_SERVER_PORT=8087
CLOTHO_DB_HOST=${COMMON_DB_HOST}
CLOTHO_DB_PORT=${COMMON_DB_PORT}
CLOTHO_DB_USERNAME=clotho
CLOTHO_DB_PASSWORD=password
CLOTHO_DB_NAME=clotho_db
CLOTHO_REDIS_ADDRESS=${COMMON_REDIS_HOST}:${COMMON_REDIS_PORT}
CLOTHO_REDIS_PASSWORD=${COMMON_REDIS_PASSWORD}
CLOTHO_CUSTOS_GRPC_ADDRESS=custos:${CUSTOS_APP_PORT_GRPC} # Depends on Custos gRPC port
CLOTHO_ORDERS_GRPC_ADDRESS=clotho:${CLOTHO_GRPC_PORT} # Self-reference, assume internal
CLOTHO_PAYMENTS_GRPC_ADDRESS=plutus:${PLUTUS_SERVER_GRPC_PORT} # Depends on Plutus gRPC port


# ========================================
# Service: Custos (认证服务)
# HTTP: 8082, gRPC: 9001, MySQL: 3306, Redis: 6379 (Internal)
# ========================================
CUSTOS_APP_PORT_HTTP=8082
CUSTOS_APP_PORT_GRPC=9001
CUSTOS_DB_HOST=${COMMON_DB_HOST}
CUSTOS_DB_PORT=${COMMON_DB_PORT}
CUSTOS_DB_USER=custos
CUSTOS_DB_PASSWORD=custospassword
CUSTOS_DB_DATABASE=custos
CUSTOS_REDIS_HOST=${COMMON_REDIS_HOST}
CUSTOS_REDIS_PORT=${COMMON_REDIS_PORT}
CUSTOS_REDIS_PASSWORD=${COMMON_REDIS_PASSWORD}
CUSTOS_JWT_SECRET=dev-secret-change-me
CUSTOS_OAUTH_STATE_KEY=dev-oauth-state-key-change-me


# ========================================
# Service: Hermes (客户服务)
# HTTP: 8081, gRPC: 9081, MySQL: 3306, Redis: 6379 (Internal), Jaeger
# ========================================
HERMES_APP_NAME=hermes-service
HERMES_SERVER_HTTP_PORT=8081
HERMES_SERVER_GRPC_PORT=9081
HERMES_DB_HOST=${COMMON_DB_HOST}
HERMES_DB_PORT=${COMMON_DB_PORT}
HERMES_DB_USERNAME=hermes
HERMES_DB_PASSWORD=hermespassword
HERMES_DB_NAME=hermes
HERMES_REDIS_HOST=${COMMON_REDIS_HOST}
HERMES_REDIS_PORT=${COMMON_REDIS_PORT}
HERMES_REDIS_PASSWORD=${COMMON_REDIS_PASSWORD}
HERMES_OBSERVABILITY_ENDPOINT=http://jaeger:${COMMON_JAEGER_PORT_OTLP}
HERMES_OBSERVABILITY_SERVICE_NAME=hermes


# ========================================
# Service: Kratos (用户服务)
# HTTP: 8082, gRPC: 9092, MySQL: 3306, Redis: 6379 (Internal), Jaeger
# Depends on Custos
# ========================================
KRATOS_APP_NAME=kratos-service
KRATOS_SERVER_HTTP_PORT=8088
KRATOS_SERVER_GRPC_PORT=9092
KRATOS_DB_HOST=${COMMON_DB_HOST}
KRATOS_DB_PORT=${COMMON_DB_PORT}
KRATOS_DB_USERNAME=root
KRATOS_DB_PASSWORD=password
KRATOS_DB_NAME=kratos
KRATOS_REDIS_HOST=${COMMON_REDIS_HOST}
KRATOS_REDIS_PORT=${COMMON_REDIS_PORT}
KRATOS_REDIS_PASSWORD=${COMMON_REDIS_PASSWORD}
KRATOS_OBSERVABILITY_ENDPOINT=http://jaeger:${COMMON_JAEGER_PORT_OTLP}
KRATOS_OBSERVABILITY_SERVICE_NAME=kratos
KRATOS_CUSTOS_GRPC_ADDRESS=custos:${CUSTOS_APP_PORT_GRPC} # Depends on Custos gRPC port


# ========================================
# Service: Plutus (支付服务)
# HTTP: 8085, gRPC: 9085, MySQL: 3306, Redis: 6379 (Internal), Jaeger
# ========================================
PLUTUS_APP_NAME=plutus-service
PLUTUS_SERVER_HTTP_PORT=8085
PLUTUS_SERVER_GRPC_PORT=9085
PLUTUS_DB_HOST=${COMMON_DB_HOST}
PLUTUS_DB_PORT=${COMMON_DB_PORT}
PLUTUS_DB_USERNAME=plutus
PLUTUS_DB_PASSWORD=plutuspassword
PLUTUS_DB_NAME=plutus
PLUTUS_REDIS_HOST=${COMMON_REDIS_HOST}
PLUTUS_REDIS_PORT=${COMMON_REDIS_PORT}
PLUTUS_REDIS_PASSWORD=${COMMON_REDIS_PASSWORD}
PLUTUS_OBSERVABILITY_ENDPOINT=http://jaeger:${COMMON_JAEGER_PORT_OTLP}
PLUTUS_OBSERVABILITY_SERVICE_NAME=plutus


# ========================================
# Service: Staff (员工服务)
# HTTP: 8086, gRPC: 9086, MySQL: 3306
# ========================================
STAFF_APP_NAME=staff-service
STAFF_SERVER_HTTP_PORT=8089
STAFF_SERVER_GRPC_PORT=9086
STAFF_DB_HOST=${COMMON_DB_HOST}
STAFF_DB_PORT=${COMMON_DB_PORT}
STAFF_DB_USERNAME=root
STAFF_DB_PASSWORD=password
STAFF_DB_NAME=staff