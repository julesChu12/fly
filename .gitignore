# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
.vscode/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov
**/coverage.out
**/*_coverage.out
**/*_coverage_final.out
*.coverage

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Go sum files - exclude from version control
*.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/
.claude/

# Logs
logs/
*.log
**/logs/

# Binary files
bin/
**/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Temporary files
tmp/
**/tmp/
*.tmp
*.bak
*~

# Process ID files
*.pid
**/*.pid

# Service specific files
*.log
*.service
*.lock
*.sock

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Build artifacts
*.test
*.out
coverage.*
*.coverprofile
profile.cov

# Environment files
.env
.env.local
.env.*.local

# IDE files
.idea/
.vscode/
.claude/
*.swp
*.swo

# Go specific
vendor/
go.work
go.work.sum

# Database files
*.db
*.sqlite
*.sqlite3
*/data/*.db
**/mysql/data/
**/data/*.ibd
**/data/*.dblwr
**/data/*.pem
**/data/*.key
**/data/*.crt
**/data/*.p12
**/data/*.jks

# Go module cache (outside vendor)
**/github.com/
**/golang.org/
**/gopkg.in/