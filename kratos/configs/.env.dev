# Application
APP_ENV=development
APP_NAME=kratos-service
GIN_MODE=debug
LOG_LEVEL=info
LOG_FORMAT=json

# Server
SERVER_HTTP_PORT=8082
SERVER_GRPC_PORT=9092
SERVER_HOST=0.0.0.0

# Database
DB_HOST=mysql
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=password
DB_NAME=kratos
DB_ROOT_PASSWORD=password

# Redis
REDIS_HOST=redis
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# Observability
OBSERVABILITY_ENDPOINT=http://jaeger:4317
OBSERVABILITY_SERVICE_NAME=kratos
