# Step 1: Build stage
FROM golang:1.25.1-alpine AS builder

ENV CGO_ENABLED=0 GOOS=linux GO111MODULE=on

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -ldflags="-s -w" -o kratos ./cmd/kratos

# Step 2: Runtime stage
FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /app

COPY --from=builder /build/kratos /app/kratos
COPY --from=builder /build/configs /app/configs

RUN adduser -D -s /bin/sh kratos
USER kratos

EXPOSE 8082 9092
ENTRYPOINT ["/app/kratos"]
CMD ["serve"]

