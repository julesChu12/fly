# Environment variables template for Items Service
# Copy this file to .env.dev, .env.stg, .env.prod and modify values

# Application Environment
APP_ENV=development
APP_NAME=items-service
APP_VERSION=1.0.0

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8086
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_IDLE_TIMEOUT=60

# gRPC Configuration
GRPC_PORT=50056
GRPC_TIMEOUT=30
GRPC_MAX_RECV_MSG_SIZE=4194304
GRPC_MAX_SEND_MSG_SIZE=4194304

# Database Configuration
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=rootpassword
DB_DATABASE=items
DB_CHARSET=utf8mb4
DB_PARSE_TIME=true
DB_LOC=Local
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=3600

# Redis Configuration
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5

# Service Discovery
DISCOVERY_ENABLED=false
CONSUL_ADDRESS=localhost:8500
CONSUL_HEALTH_CHECK_INTERVAL=10

# Observability
OTEL_SERVICE_NAME=items
OTEL_EXPORTER_URL=http://jaeger:4317
OTEL_SAMPLE_RATIO=1.0
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_TYPE=stdout

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Docker Configuration
DOCKER_REGISTRY=your-registry.com
DOCKER_IMAGE_NAME=items-service
DOCKER_TAG=latest

# Build Configuration
BUILD_TARGET=local
GO_VERSION=1.25.1
BUILD_OS=linux
BUILD_ARCH=amd64