# Production Environment Configuration
APP_ENV=production
BUILD_TARGET=prod
GO_VERSION=1.25.1
BUILD_OS=linux
BUILD_ARCH=amd64

# Docker Image Configuration
DOCKER_IMAGE_PREFIX=fly-prod
DOCKER_TAG=latest

# Services
CUSTOS_IMAGE_NAME=custos-service
HERMES_IMAGE_NAME=hermes-service
KRATOS_IMAGE_NAME=kratos-service
PLUTUS_IMAGE_NAME=plutus-service
APPOINTMENTS_IMAGE_NAME=appointments-service
CLOTHO_IMAGE_NAME=clotho-service

# Production Options
GIN_MODE=release
LOG_LEVEL=info