# Application
APP_ENV=development
APP_NAME=hermes-service
GIN_MODE=debug
LOG_LEVEL=info
LOG_FORMAT=json

# Server
SERVER_HTTP_PORT=8081
SERVER_GRPC_PORT=9081
SERVER_HOST=0.0.0.0

# Database
DB_HOST=mysql
DB_PORT=3309
DB_USERNAME=hermes
DB_PASSWORD=hermespassword
DB_NAME=hermes
DB_ROOT_PASSWORD=rootpassword

# Redis
REDIS_HOST=redis
REDIS_PORT=6382
REDIS_PASSWORD=
REDIS_DB=0

# Observability
OBSERVABILITY_ENDPOINT=http://jaeger:4320
OBSERVABILITY_SERVICE_NAME=hermes
