# 生产环境环境变量配置示例
# 使用方式: cp .env.prod.example .env.prod && vim .env.prod

# ========================
# Grafana 配置
# ========================
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-in-production

# ========================
# Elasticsearch 配置
# ========================
ELASTICSEARCH_PASSWORD=change-me-in-production

# ========================
# Kibana 配置
# ========================
KIBANA_PASSWORD=change-me-in-production

# ========================
# SMTP 邮件配置（AlertManager 告警通知）
# ========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ========================
# NFS 存储配置（生产环境）
# ========================
NFS_SERVER=nfs-server.example.com

# ========================
# 其他生产配置
# ========================
ENVIRONMENT=production
LOG_LEVEL=info
