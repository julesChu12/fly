# Application
APP_ENV=development
APP_PORT=8082

# Database
DB_HOST=mysql
DB_PORT=3310
DB_USER=custos
DB_PASSWORD=custospassword
DB_DATABASE=custos
DB_CHARSET=utf8mb4
DB_ROOT_PASSWORD=rootpassword

# Redis
REDIS_HOST=redis
REDIS_PORT=6383
REDIS_PASSWORD=
REDIS_DB=0


# JWT
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# Log
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT_PATH=logs/custos.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=7
LOG_MAX_AGE=30
LOG_COMPRESS=true
LOG_ENABLE_STDOUT=true
LOG_ENABLE_FILE=true

# OAuth
OAUTH_STATE_KEY=dev-oauth-state-key-change-me
OAUTH_STATE_TTL=600

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
