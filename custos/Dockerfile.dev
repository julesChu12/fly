FROM golang:1.25.1-alpine

WORKDIR /app

# 安装必要的工具
RUN apk add --no-cache git gcc musl-dev

# 安装 Air
RUN go install github.com/air-verse/air@latest

# 复制本地依赖模块 mora
COPY mora /mora

# 复制 go.mod 和 go.sum (从 custos 目录)
COPY custos/go.mod custos/go.sum ./

# 下载依赖
RUN go mod download

# 复制源代码 (从 custos 目录)
COPY custos/ .

# 暴露端口
EXPOSE 8081

# 启动 Air
CMD ["air"] 