    "definitions": {
        "dto.AvailabilityItem": {
            "type": "object",
            "required": [
                "day_of_week",
                "end_time",
                "start_time"
            ],
            "properties": {
                "day_of_week": {
                    "description": "0-6 (Sunday-Saturday)",
                    "type": "integer",
                    "maximum": 6,
                    "minimum": 0
                },
                "end_time": {
                    "description": "HH:MM",
                    "type": "string"
                },
                "is_available": {
                    "type": "boolean"
                },
                "notes": {
                    "type": "string"
                },
                "start_time": {
                    "description": "HH:MM",
                    "type": "string"
                }
            }
        },
        "dto.AvailabilityRequest": {
            "type": "object",
            "required": [
                "availabilities",
                "staff_id"
            ],
            "properties": {
                "availabilities": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/dto.AvailabilityItem"
                    }
                },
                "staff_id": {
                    "type": "string"
                }
            }
        },
        "dto.AvailableStaffRequest": {
            "type": "object",
            "required": [
                "date_time"
            ],
            "properties": {
                "date_time": {
                    "type": "string"
                },
                "department": {
                    "type": "string"
                },
                "skills": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "dto.CreateRoleRequest": {
            "type": "object",
            "required": [
                "code",
                "name"
            ],
            "properties": {
                "code": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1
                },
                "description": {
                    "type": "string"
                },
                "is_default": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1
                },
                "permissions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "sort_order": {
                    "type": "integer"
                },
                "status": {
                    "enum": [
                        "active",
                        "inactive"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/entity.StaffStatus"
                        }
                    ]
                }
            }
        },
        "dto.CreateStaffRequest": {
            "type": "object",
            "required": [
                "department",
                "email",
                "name",
                "position",
                "role_id"
            ],
            "properties": {
                "address": {
                    "type": "string"
                },
                "avatar": {
                    "type": "string"
                },
                "birthday": {
                    "type": "string"
                },
                "department": {
                    "type": "string",
                    "maxLength": 100
                },
                "email": {
                    "type": "string",
                    "maxLength": 255
                },
                "emergency_contact": {
                    "type": "string"
                },
                "gender": {
                    "enum": [
                        "male",
                        "female",
                        "other"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/entity.Gender"
                        }
                    ]
                },
                "hire_date": {
                    "type": "string"
                },
                "is_available": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1
                },
                "notes": {
                    "type": "string"
                },
                "phone": {
                    "type": "string",
                    "maxLength": 20
                },
                "position": {
                    "type": "string",
                    "maxLength": 100
                },
                "role_id": {
                    "type": "string"
                },
                "salary": {
                    "type": "number"
                },
                "skills": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "status": {
                    "enum": [
                        "active",
                        "inactive",
                        "on_leave",
                        "suspended"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/entity.StaffStatus"
                        }
                    ]
                },
                "user_id": {
                    "type": "string"
                },
                "working_hours": {
                    "$ref": "#/definitions/dto.WorkingHours"
                }
            }
        },
        "dto.DaySchedule": {
            "type": "object",
            "properties": {
                "break_end": {
                    "description": "HH:MM",
                    "type": "string"
