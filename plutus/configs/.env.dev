# Application
APP_ENV=development
APP_NAME=plutus-service
GIN_MODE=debug
LOG_LEVEL=info
LOG_FORMAT=json

# Server
SERVER_HTTP_PORT=8085
SERVER_GRPC_PORT=9085
SERVER_HOST=0.0.0.0

# Database
DB_HOST=mysql
DB_PORT=3308
DB_USERNAME=plutus
DB_PASSWORD=plutuspassword
DB_NAME=plutus
DB_ROOT_PASSWORD=rootpassword

# Redis
REDIS_HOST=redis
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_DB=0

# Observability
OBSERVABILITY_ENDPOINT=http://jaeger:4319
OBSERVABILITY_SERVICE_NAME=plutus
