# Application
APP_ENV=development
APP_NAME=clotho-service
GIN_MODE=debug
LOG_LEVEL=info
LOG_FORMAT=json

# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Security
JWT_SECRET=development-secret-key-change-in-production

# Service Discovery
CUSTOS_GRPC_ADDRESS=custos:9001
ORDERS_GRPC_ADDRESS=orders:9002
PAYMENTS_GRPC_ADDRESS=payments:9003

# Database
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=clotho
DB_PASSWORD=password
DB_NAME=clotho_db
DB_ROOT_PASSWORD=rootpassword

# Redis
REDIS_ADDRESS=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
