# Development Environment Configuration for Appointments Service

# Application Environment
APP_ENV=development
APP_NAME=appointments-service
APP_VERSION=1.0.0

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=18083
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_IDLE_TIMEOUT=60

# gRPC Configuration
GRPC_PORT=15083
GRPC_TIMEOUT=30
GRPC_MAX_RECV_MSG_SIZE=4194304
GRPC_MAX_SEND_MSG_SIZE=4194304

# Database Configuration (SQLite for development)
DB_DRIVER=sqlite
DB_DSN=./data/appointments.db
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=3600

# Redis Configuration
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=2
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5

# Service Discovery
DISCOVERY_ENABLED=false

# Observability
OTEL_SERVICE_NAME=appointments
OTEL_SAMPLE_RATIO=1.0
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_TYPE=stdout

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Docker Configuration
DOCKER_IMAGE_NAME=appointments-service
DOCKER_TAG=dev

# Build Configuration
BUILD_TARGET=dev

# External Services Configuration (Development endpoints)
CUSTOS_GRPC_ADDRESS=localhost:9001
KRATOS_GRPC_ADDRESS=localhost:9092
PLUTUS_GRPC_ADDRESS=localhost:9085
STAFF_GRPC_ADDRESS=localhost:9090

# Order Integration Configuration
ORDER_INTEGRATION_ENABLED=true
AUTO_PAYMENT_ENABLED=true
PAYMENT_TIMEOUT=1800
ORDER_TIMEOUT=3600
MAX_RETRIES=3
RETRY_DELAY=5
NOTIFICATIONS_ENABLED=true
CLEANUP_INTERVAL=3600
RETENTION_PERIOD=604800

# Hot Reload Configuration
AIR_PORT=8084
AIR_TMP_DIR=./tmp