# Production Environment Configuration for Appointments Service

# Application Environment
APP_ENV=production
APP_NAME=appointments-service
APP_VERSION=1.0.0

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=18083
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_IDLE_TIMEOUT=60

# gRPC Configuration
GRPC_PORT=15083
GRPC_TIMEOUT=30
GRPC_MAX_RECV_MSG_SIZE=4194304
GRPC_MAX_SEND_MSG_SIZE=4194304

# Database Configuration (MySQL for production)
DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=fly_user
DB_PASSWORD=rootpassword
DB_DATABASE=appointments
DB_CHARSET=utf8mb4
DB_PARSE_TIME=true
DB_LOC=Local
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=3600

# Redis Configuration
REDIS_ADDRESS=redis:6379
REDIS_PASSWORD=
REDIS_DB=2
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5

# Service Discovery
DISCOVERY_ENABLED=true
CONSUL_ADDRESS=consul:8500
CONSUL_HEALTH_CHECK_INTERVAL=10

# Observability
OTEL_SERVICE_NAME=appointments
OTEL_EXPORTER_URL=http://jaeger:4317
OTEL_SAMPLE_RATIO=0.1
OTEL_ENVIRONMENT=production
OTEL_EXPORTER_TYPE=jaeger

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Docker Configuration
DOCKER_REGISTRY=your-registry.com
DOCKER_IMAGE_NAME=appointments-service
DOCKER_TAG=latest

# Build Configuration
BUILD_TARGET=prod

# External Services Configuration (Production endpoints)
CUSTOS_GRPC_ADDRESS=custos:9001
KRATOS_GRPC_ADDRESS=kratos:9092
PLUTUS_GRPC_ADDRESS=plutus:9085
STAFF_GRPC_ADDRESS=staff:9090

# Order Integration Configuration
ORDER_INTEGRATION_ENABLED=true
AUTO_PAYMENT_ENABLED=true
PAYMENT_TIMEOUT=1800
ORDER_TIMEOUT=3600
MAX_RETRIES=3
RETRY_DELAY=5
NOTIFICATIONS_ENABLED=true
CLEANUP_INTERVAL=3600
RETENTION_PERIOD=604800